{
  "name": "oddity",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "vue-tsc --noEmit",
    "build": "pnpm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write . ../../scripts/check-frontend-coverage.mjs ../../scripts/check-rust-coverage.mjs ../../scripts/prepare-release-notes-labels.mjs && prettier --write --ignore-path /dev/null ../../internal/gamepad/acceptance/*.test.ts",
    "format:check": "prettier --check . ../../scripts/check-frontend-coverage.mjs ../../scripts/check-rust-coverage.mjs ../../scripts/prepare-release-notes-labels.mjs && prettier --check --ignore-path /dev/null ../../internal/gamepad/acceptance/*.test.ts",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:coverage": "node ../../scripts/check-frontend-coverage.mjs",
    "desktop:build": "pnpm run build && node electron/build.mjs",
    "desktop:dev": "pnpm run desktop:build && electron .",
    "desktop:package": "pnpm run desktop:build && electron-builder --linux --config electron-builder.cjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@vueuse/core": "14.4.0",
    "animejs": "^4.5.0",
    "motion-dom": "~14.3.1",
    "motion-v": "2.8.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.14.0",
  "main": "desktop-dist/main.cjs",
  "description": "Linux launcher for Neverness To Everness",
  "author": "LaT-SKY <miprota@163.com>",
  "license": "GPL-3.0-or-later",
  "desktopName": "oddity.desktop",
  "homepage": "https://github.com/LaT-SKY/Oddity"
}
