{
  "name": "oddity-ui",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "vue-tsc --noEmit",
    "build": "pnpm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write . ../../scripts/check-frontend-coverage.mjs",
    "format:check": "prettier --check . ../../scripts/check-frontend-coverage.mjs",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:coverage": "node ../../scripts/check-frontend-coverage.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@vueuse/core": "14.4.0",
    "motion-dom": "~14.3.1",
    "motion-v": "2.8.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.14.0"
}
