EAPI=8

inherit desktop optfeature xdg

DESCRIPTION="Native Linux launcher for Neverness To Everness"
HOMEPAGE="https://github.com/LaT-SKY/Oddity"

MY_PV="@UPSTREAM@"
SRC_URI="@URL@"
S="${WORKDIR}/oddity-${MY_PV}-linux-x86_64"

LICENSE="GPL-3+"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="strip"
QA_PREBUILT="*"

RDEPEND="
	app-accessibility/at-spi2-core
	app-crypt/libsecret
	dev-libs/glib:2
	dev-util/desktop-file-utils
	gnome-base/librsvg
	virtual/libudev
	media-libs/alsa-lib
	media-libs/libpulse
	dev-libs/nss
	media-libs/mesa
	x11-libs/libXScrnSaver
	x11-libs/libXtst
	net-print/cups
	x11-libs/cairo
	x11-libs/gdk-pixbuf:2
	x11-libs/gtk+:3
	x11-libs/pango
	x11-misc/xdg-utils
	x11-themes/hicolor-icon-theme
"

src_install() {
	dodir /opt/Oddity
	cp -a . "${ED}/opt/Oddity/" || die
	fperms 0755 /opt/Oddity/oddity /opt/Oddity/oddity-shell /opt/Oddity/chrome-sandbox
	for binary in oddity nte-cli oddity-recovery; do
		dosym "/opt/Oddity/${binary}" "/usr/bin/${binary}"
	done
	fperms 0755 /opt/Oddity/resources/bin/oddity /opt/Oddity/resources/bin/oddity-backend /opt/Oddity/resources/bin/nte-cli /opt/Oddity/resources/bin/oddity-recovery
	domenu oddity.desktop oddity-recovery.desktop

	for size in 16 22 24 32 48 64 128 256 512; do
		newicon -s "${size}" "icons/${size}x${size}.png" oddity.png
	done

	dodoc README.md THIRD_PARTY.md
}

pkg_postinst() {
	optfeature "run the game through Proton" games-util/umu-launcher
	xdg_pkg_postinst
}

pkg_postrm() {
	xdg_pkg_postrm
}
